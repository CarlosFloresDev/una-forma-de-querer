/* =====================================================================
   Diálogo — «Una forma de querer»
   Papel crema, tinta cálida y un único color saturado: el DORADO de las señales.
   ===================================================================== */

.dialogo {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    padding: 32px 48px;
    transition-property: opacity;
    transition-duration: 0.35s;
}

.dialogo--oculto {
    opacity: 0;
    display: none;
}

/* --- Título ----------------------------------------------------------- */
.titulo {
    position: absolute;
    left: 0; right: 0; top: 40%;
    -unity-text-align: middle-center;
    font-size: 44px;
    letter-spacing: 8px;
    color: rgb(244, 236, 220);
    -unity-font-style: bold;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
    display: none;
}

/* --- Voz interior ----------------------------------------------------- */
.voz-interior {
    position: absolute;
    left: 10%; right: 10%; top: 12%;
    -unity-text-align: middle-center;
    -unity-font-style: italic;
    font-size: 30px;
    white-space: normal;
    color: rgb(250, 244, 232);
    text-shadow: 0 2px 10px rgba(20, 12, 30, 0.85);
    display: none;
}

/* --- Celular ---------------------------------------------------------- */
.celular {
    position: absolute;
    right: 6%; top: 18%;
    width: 300px;
    padding: 18px 16px;
    border-radius: 22px;
    background-color: rgb(28, 26, 34);
    border-width: 6px;
    border-color: rgb(14, 13, 18);
    display: none;
}

.celular__remitente {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(217, 164, 65);
    margin-bottom: 8px;
}

.celular__mensaje {
    font-size: 19px;
    white-space: normal;
    color: rgb(30, 28, 36);
    background-color: rgb(236, 230, 218);
    border-radius: 14px;
    padding: 10px 12px;
}

.celular--enviado .celular__mensaje {
    background-color: rgb(197, 220, 246);
    align-self: flex-end;
}

/* --- Parte inferior --------------------------------------------------- */
.inferior {
    position: absolute;
    left: 0; right: 0; bottom: 36px;
    align-items: center;
}

.globo {
    max-width: 900px;
    min-width: 420px;
    padding: 18px 26px 20px 26px;
    border-radius: 18px;
    background-color: rgba(243, 234, 211, 0.96);
    border-width: 2px;
    border-color: rgba(138, 90, 60, 0.35);
    display: none;
}

.globo__nombre {
    font-size: 15px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: rgb(138, 90, 60);
    margin-bottom: 6px;
}

.globo__texto {
    font-size: 25px;
    white-space: normal;
    color: rgb(42, 33, 30);
}

.accion {
    max-width: 860px;
    margin-top: 10px;
    font-size: 19px;
    -unity-font-style: italic;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgba(250, 244, 232, 0.92);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.75);
    display: none;
}

/* El único color saturado del juego. */
.guardar {
    margin-top: 14px;
    padding: 8px 22px;
    border-radius: 20px;
    border-width: 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(42, 30, 8);
    background-color: rgb(217, 164, 65);
    display: none;
    transition-property: scale, background-color;
    transition-duration: 0.25s;
}

.guardar:hover {
    scale: 1.06 1.06;
    background-color: rgb(236, 186, 86);
}

.guardar--guardado {
    background-color: rgb(243, 234, 211);
    color: rgb(138, 90, 60);
}

.opciones {
    margin-top: 12px;
    align-items: center;
}

.opcion {
    min-width: 520px;
    margin-top: 6px;
    padding: 10px 18px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(138, 90, 60, 0.4);
    font-size: 21px;
    white-space: normal;
    color: rgb(42, 33, 30);
    background-color: rgba(243, 234, 211, 0.94);
    -unity-text-align: middle-left;
}

.opcion:hover, .opcion:focus {
    background-color: rgb(250, 242, 222);
    border-color: rgb(138, 90, 60);
}

.continuar {
    margin-top: 10px;
    font-size: 14px;
    color: rgba(250, 244, 232, 0.55);
}

/* --- La Lente: frase con doble lectura -------------------------------- */
.globo--lente {
    border-color: rgba(217, 164, 65, 0.55);
}

/* Versión «algo más»: más cálida, más redonda. Es lo que Mateo QUIERE leer. */
.globo--reescrita .globo__texto {
    color: rgb(150, 70, 52);
    -unity-font-style: italic;
    font-size: 27px;
}

.globo--reescrita {
    background-color: rgba(250, 232, 210, 0.97);
}